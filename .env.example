# Copy to .env.local (git-ignored) and fill in to prefill the login form in `yarn dev`.
#
# These values are used ONLY in development mode. Production builds strip them,
# and the build fails if the token is found in the output — never rely on .env
# to ship credentials: in a browser app anything in the bundle is public.
#
# Get them in https://console.green-api.com → your MAX instance.

VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_TOKEN_INSTANCE=
# Optional: defaults to https://{first 4 digits of idInstance}.api.green-api.com
VITE_GREEN_API_URL=
